PORT=3000
NODE_ENV=development

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Shared Development Database on MongoDB Atlas (Recommended for Team Collaboration)
# Connects to the cloud cluster using the dedicated non-production 'wepair_dev' database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wepair_dev?retryWrites=true&w=majority
MONGODB_DB_NAME=wepair_dev

# Offline Local MongoDB (Optional for solo offline development)
# MONGODB_URI=mongodb://127.0.0.1:27017/wepair
# MONGODB_DB_NAME=wepair

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==============================================================================
# THIRD-PARTY INTEGRATIONS
# ==============================================================================
# Cloudinary (Image & Document Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Payments - Test Mode Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
